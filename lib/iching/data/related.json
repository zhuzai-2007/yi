{
  "序卦": {
    "source": {
      "url": "https://zh.wikisource.org/w/index.php?title=%E6%98%93%E5%82%B3%2F%E5%BA%8F%E5%8D%A6&oldid=2611127",
      "revision": "2611127",
      "sha256": "68a0d2b2b08363aa856e6a1a05f40890530a9b980340e57a23c1825505810574"
    },
    "passages": [
      {
        "numbers": [
          1,
          2
        ],
        "text": "有天地，然後萬物生焉。"
      },
      {
        "numbers": [
          3
        ],
        "text": "盈天地之間者，唯萬物，故受之以屯；屯者盈也，屯者物之始生也。"
      },
      {
        "numbers": [
          4
        ],
        "text": "物生必蒙，故受之以蒙；蒙者蒙也，物之穉也。"
      },
      {
        "numbers": [
          5
        ],
        "text": "物穉不可不養也，故受之以需；需者飲食之道也。"
      },
      {
        "numbers": [
          6
        ],
        "text": "飲食必有訟，故受之以訟。"
      },
      {
        "numbers": [
          7
        ],
        "text": "訟必有眾起，故受之以師；師者眾也。"
      },
      {
        "numbers": [
          8
        ],
        "text": "眾必有所比，故受之以比；比者比也。"
      },
      {
        "numbers": [
          9
        ],
        "text": "比必有所畜也，故受之以小畜。"
      },
      {
        "numbers": [
          10
        ],
        "text": "物畜然後有禮，故受之以履。"
      },
      {
        "numbers": [
          11
        ],
        "text": "履而泰，然後安，故受之以泰；泰者通也。"
      },
      {
        "numbers": [
          12
        ],
        "text": "物不可以終通，故受之以否。"
      },
      {
        "numbers": [
          13
        ],
        "text": "物不可以終否，故受之以同人。"
      },
      {
        "numbers": [
          14
        ],
        "text": "與人同者，物必歸焉，故受之以大有。"
      },
      {
        "numbers": [
          15
        ],
        "text": "有大者不可以盈，故受之以謙。"
      },
      {
        "numbers": [
          16
        ],
        "text": "有大而能謙，必豫，故受之以豫。"
      },
      {
        "numbers": [
          17
        ],
        "text": "豫必有隨，故受之以隨。"
      },
      {
        "numbers": [
          18
        ],
        "text": "以喜隨人者，必有事，故受之以蠱；蠱者事也。"
      },
      {
        "numbers": [
          19
        ],
        "text": "有事而后可大，故受之以臨；臨者大也。"
      },
      {
        "numbers": [
          20
        ],
        "text": "物大然後可觀，故受之以觀。"
      },
      {
        "numbers": [
          21
        ],
        "text": "可觀而后有所合，故受之以噬嗑；嗑者合也。"
      },
      {
        "numbers": [
          22
        ],
        "text": "物不可以苟合而已，故受之以賁；賁者飾也。"
      },
      {
        "numbers": [
          23
        ],
        "text": "致飾然後亨，則盡矣，故受之以剝；剝者剝也。"
      },
      {
        "numbers": [
          24
        ],
        "text": "物不可以終盡，剝窮上反下，故受之以復。"
      },
      {
        "numbers": [
          25
        ],
        "text": "復則不妄矣，故受之以无妄。"
      },
      {
        "numbers": [
          26
        ],
        "text": "有无妄然後可畜，故受之以大畜。"
      },
      {
        "numbers": [
          27
        ],
        "text": "物畜然後可養，故受之以頤；頤者養也。"
      },
      {
        "numbers": [
          28
        ],
        "text": "不養則不可動，故受之以大過。"
      },
      {
        "numbers": [
          29
        ],
        "text": "物不可以終過，故受之以坎；坎者陷也。"
      },
      {
        "numbers": [
          30
        ],
        "text": "陷必有所麗，故受之以離；離者麗也。"
      },
      {
        "numbers": [
          31
        ],
        "text": "有天地然後有萬物，有萬物然後有男女，有男女然後有夫婦，有夫婦然後有父子，有父子然後有君臣，有君臣然後有上下，有上下然後禮儀有所錯。"
      },
      {
        "numbers": [
          32
        ],
        "text": "夫婦之道，不可以不久也，故受之以恆；恆者久也。"
      },
      {
        "numbers": [
          33
        ],
        "text": "物不可以久居其所，故受之以遯；遯者退也。"
      },
      {
        "numbers": [
          34
        ],
        "text": "物不可終遯，故受之以大壯。"
      },
      {
        "numbers": [
          35
        ],
        "text": "物不可以終壯，故受之以晉；晉者進也。"
      },
      {
        "numbers": [
          36
        ],
        "text": "進必有所傷，故受之以明夷；夷者傷也。"
      },
      {
        "numbers": [
          37
        ],
        "text": "傷於外者，必反其家，故受之以家人。"
      },
      {
        "numbers": [
          38
        ],
        "text": "家道窮必乖，故受之以睽；睽者乖也。"
      },
      {
        "numbers": [
          39
        ],
        "text": "乖必有難，故受之以蹇；蹇者難也。"
      },
      {
        "numbers": [
          40
        ],
        "text": "物不可終難，故受之以解；解者緩也。"
      },
      {
        "numbers": [
          41
        ],
        "text": "緩必有所失，故受之以損。"
      },
      {
        "numbers": [
          42
        ],
        "text": "損而不已，必益，故受之以益。"
      },
      {
        "numbers": [
          43
        ],
        "text": "益而不已，必決，故受之以夬； 夬者決也。"
      },
      {
        "numbers": [
          44
        ],
        "text": "決必有所遇，故受之以姤；姤者遇也。"
      },
      {
        "numbers": [
          45
        ],
        "text": "物相遇而后聚，故受之以萃；萃者聚也。"
      },
      {
        "numbers": [
          46
        ],
        "text": "聚而上者，謂之升，故受之以升。"
      },
      {
        "numbers": [
          47
        ],
        "text": "升而不已，必困，故受之以困。"
      },
      {
        "numbers": [
          48
        ],
        "text": "困乎上者，必反下，故受之以井。"
      },
      {
        "numbers": [
          49
        ],
        "text": "井道不可不革，故受之以革。"
      },
      {
        "numbers": [
          50
        ],
        "text": "革物者莫若鼎，故受之以鼎。"
      },
      {
        "numbers": [
          51
        ],
        "text": "主器者莫若長子，故受之以震；震者動也。"
      },
      {
        "numbers": [
          52
        ],
        "text": "物不可以終動，止之，故受之以艮；艮者止也。"
      },
      {
        "numbers": [
          53
        ],
        "text": "物不可以終止，故受之以漸；漸者進也。"
      },
      {
        "numbers": [
          54
        ],
        "text": "進必有所歸，故受之以歸妹。"
      },
      {
        "numbers": [
          55
        ],
        "text": "得其所歸者必大，故受之以豐；豐者大也。"
      },
      {
        "numbers": [
          56
        ],
        "text": "窮大者必失其居，故受之以旅。"
      },
      {
        "numbers": [
          57
        ],
        "text": "旅而無所容，故受之以巽；巽者入也。"
      },
      {
        "numbers": [
          58
        ],
        "text": "入而后說之，故受之以兌；兌者說也。"
      },
      {
        "numbers": [
          59
        ],
        "text": "說而后散之，故受之以渙；渙者離也。"
      },
      {
        "numbers": [
          60
        ],
        "text": "物不可以終離，故受之以節。"
      },
      {
        "numbers": [
          61
        ],
        "text": "節而信之，故受之以中孚。"
      },
      {
        "numbers": [
          62
        ],
        "text": "有其信者，必行之，故受之以小過。"
      },
      {
        "numbers": [
          63
        ],
        "text": "有過物者，必濟，故受之既濟。"
      },
      {
        "numbers": [
          64
        ],
        "text": "物不可窮也，故受之以未濟；終焉。"
      }
    ]
  },
  "雜卦": {
    "source": {
      "url": "https://zh.wikisource.org/w/index.php?title=%E6%98%93%E5%82%B3%2F%E9%9B%9C%E5%8D%A6&oldid=2611129",
      "revision": "2611129",
      "sha256": "e2c6368385cf09af40a72164ccd860cf6919d1ec8624868a2d9af2e80ef0aafe"
    },
    "passages": [
      {
        "numbers": [
          1,
          2,
          8,
          7
        ],
        "text": "乾剛坤柔，比樂師憂。"
      },
      {
        "numbers": [
          19,
          20
        ],
        "text": "臨、觀之義，或與或求。"
      },
      {
        "numbers": [
          3,
          4
        ],
        "text": "屯見而不失其居，蒙雜而著。"
      },
      {
        "numbers": [
          51,
          52
        ],
        "text": "震起也，艮止也。"
      },
      {
        "numbers": [
          41,
          42
        ],
        "text": "損、益，盛衰之始也。"
      },
      {
        "numbers": [
          26,
          25
        ],
        "text": "大畜時也，无妄災也。"
      },
      {
        "numbers": [
          45,
          46
        ],
        "text": "萃聚，而升不來也。"
      },
      {
        "numbers": [
          15,
          16
        ],
        "text": "謙輕，而豫怠也。"
      },
      {
        "numbers": [
          21,
          22
        ],
        "text": "噬嗑食也，賁无色也。"
      },
      {
        "numbers": [
          58,
          57
        ],
        "text": "兌見，而巽伏也。"
      },
      {
        "numbers": [
          17,
          18
        ],
        "text": "隨无故也，蠱則飭也。"
      },
      {
        "numbers": [
          23,
          24
        ],
        "text": "剝爛也，復反也。"
      },
      {
        "numbers": [
          35,
          36
        ],
        "text": "晉晝也，明夷誅也。"
      },
      {
        "numbers": [
          48,
          47
        ],
        "text": "井通，而困相遇也。"
      },
      {
        "numbers": [
          31,
          32
        ],
        "text": "咸速也，恒久也。"
      },
      {
        "numbers": [
          59,
          60
        ],
        "text": "渙離也，節止也。"
      },
      {
        "numbers": [
          40,
          39
        ],
        "text": "解緩也，蹇難也。"
      },
      {
        "numbers": [
          38,
          37
        ],
        "text": "睽外也，家人內也。"
      },
      {
        "numbers": [
          12,
          11
        ],
        "text": "否、泰，反其類也。"
      },
      {
        "numbers": [
          34,
          33
        ],
        "text": "大壯則止，遯則退也。"
      },
      {
        "numbers": [
          14,
          13
        ],
        "text": "大有眾也，同人親也。"
      },
      {
        "numbers": [
          49,
          50
        ],
        "text": "革去故也，鼎取新也。"
      },
      {
        "numbers": [
          62,
          61
        ],
        "text": "小過過也，中孚信也。"
      },
      {
        "numbers": [
          55,
          56
        ],
        "text": "豐多故也，親寡旅也。"
      },
      {
        "numbers": [
          30,
          29
        ],
        "text": "離上，而坎下也。"
      },
      {
        "numbers": [
          9,
          10
        ],
        "text": "小畜寡也，履不處也。"
      },
      {
        "numbers": [
          5,
          6
        ],
        "text": "需不進也，訟不親也。"
      },
      {
        "numbers": [
          28,
          44
        ],
        "text": "大過顛也，姤遇也，柔遇剛也。"
      },
      {
        "numbers": [
          53,
          27,
          63
        ],
        "text": "漸女歸待男行也，頤養正也，既濟定也。"
      },
      {
        "numbers": [
          54,
          64
        ],
        "text": "歸妹女之終也，未濟男之窮也。"
      },
      {
        "numbers": [
          43
        ],
        "text": "夬決也，剛決柔也。君子道長，小人道消也。"
      }
    ]
  }
}
