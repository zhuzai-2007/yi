77d\uff0c\u800c\u5176\u5fd7\u901a\u4e5f\uff1b\u842c\u7269\u777d\uff0c\u800c\u5176\u4e8b\u985e\u4e5f\uff1b\u777d\u4e4b\u6642\u7528\u5927\u77e3\u54c9\uff01\n\n*'''\u8c61\u66f0\uff1a'''\n**\u4e0a\u706b\u4e0b\u6fa4\uff0c\u777d\uff1b\u541b\u5b50\u4ee5\u540c\u800c\u7570\u3002\n*#\u898b\u60e1\u4eba\uff0c\u4ee5\u8f9f\u548e\u4e5f\u3002\n*#\u9047\u4e3b-{\u4e8e}-\u5df7\uff0c\u672a\u5931\u9053\u4e5f\u3002\n*#\u898b\u8f3f\u66f3\uff0c\u4f4d\u4e0d\u7576\u4e5f\u3002-{\u65e0}-\u521d\u6709\u7d42\uff0c\u9047\u525b\u4e5f\u3002\n*#\u4ea4\u5b5a-{\u65e0}-\u548e\uff0c\u5fd7\u884c\u4e5f\u3002\n*#\u53a5\u5b97\u566c\u819a\uff0c\u5f80\u6709\u6176\u4e5f\u3002\n*#\u9047\u96e8\u4e4b\u5409\uff0c\u7fa4\u7591\u4ea1\u4e5f\u3002"}}}]}}}}